# Copy outside version control, fill with release workflow digest outputs, then:
# source signed-images.env && lanai-portal/scripts/render-signed-kustomize.sh /secure/output/lanai.yaml
# Every value must be Cosign-signed by .github/workflows/release-images.yml.
LANAI_PORTAL_IMAGE=ghcr.io/munisp/lanai-portal@sha256:REPLACE_WITH_64_HEX_DIGEST
LANAI_AI_GATEWAY_IMAGE=ghcr.io/munisp/lanai-ai-gateway@sha256:REPLACE_WITH_64_HEX_DIGEST
LANAI_REALM_RENDER_IMAGE=ghcr.io/munisp/lanai-realm-render@sha256:REPLACE_WITH_64_HEX_DIGEST
