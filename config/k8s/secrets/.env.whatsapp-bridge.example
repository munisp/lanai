# Create the protected lanai-whatsapp-bridge-secrets Secret from this file.
# Do not commit a populated version.
# DATABASE_URL must use a dedicated least-privilege database role limited to
# whatsapp_webhook_events and the required outbox transaction tables.
DATABASE_URL=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BRIDGE_INTERNAL_TOKEN=
