# Dedicated image for live financial workflow verification in an isolated staging namespace.
# Build from repository root so pnpm's audited root lockfile remains authoritative.
FROM node:22.13.1-bookworm-slim AS dependencies
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY lanai-portal/package.json ./lanai-portal/package.json
RUN pnpm install --frozen-lockfile --filter lanai-portal...

FROM node:22.13.1-bookworm-slim AS runner
ENV NODE_ENV=production \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH
WORKDIR /workspace
RUN corepack enable && \
    addgroup --system --gid 10001 workflow && \
    adduser --system --uid 10001 --ingroup workflow --home /workspace workflow
COPY --from=dependencies /workspace/node_modules ./node_modules
COPY --from=dependencies /workspace/lanai-portal/node_modules ./lanai-portal/node_modules
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY lanai-portal ./lanai-portal
RUN mkdir -p /evidence && chown -R workflow:workflow /workspace /evidence
USER 10001:10001
ENTRYPOINT ["pnpm", "--filter", "lanai-portal", "exec", "tsx", "server/test/live-financial-workflow-runner.ts"]
