# Dedicated financial workflow evidence runner.
# Build from the workspace root so the canonical pnpm lockfile and the actual
# Temporal/TigerBeetle integration runner are included in the immutable image.
FROM node:22-bookworm-slim

ARG PNPM_VERSION=11.20.0

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates dumb-init \
  && rm -rf /var/lib/apt/lists/* \
  && npm install --global "pnpm@${PNPM_VERSION}" \
  && groupadd --gid 10001 runner \
  && useradd --uid 10001 --gid runner --create-home runner

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY lanai-portal/package.json ./lanai-portal/package.json
RUN pnpm install --frozen-lockfile --child-concurrency=1 --network-concurrency=4

COPY lanai-portal ./lanai-portal
USER 10001:10001
ENTRYPOINT ["dumb-init", "--", "pnpm", "--filter", "lanai-portal", "exec", "tsx", "server/test/live-financial-workflow-runner.ts"]
